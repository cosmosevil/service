    {
      "name": "Бизнес-операции",
      "description": "Операции страховой обработки. Роль: ADMIN или AGENT.",
      "item": [
        {
          "name": "1. Подать заявление на рассмотрение (PENDING → UNDER_REVIEW)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/insurance/claims/1/submit", "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "1", "submit"] },
            "description": "Переводит заявление из PENDING в UNDER_REVIEW. Ожидаем 200."
          }
        },
        {
          "name": "1b. Подать заявление не в статусе PENDING → 400",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/insurance/claims/1/submit", "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "1", "submit"] },
            "description": "Ожидаем 400 — заявление уже не в статусе PENDING."
          }
        },
        {
          "name": "2. Одобрить заявление (UNDER_REVIEW → APPROVED)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/insurance/claims/1/approve?approvedAmount=75000",
              "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "1", "approve"],
              "query": [{ "key": "approvedAmount", "value": "75000" }]
            },
            "description": "Сумма выплаты не может превышать лимит покрытия."
          }
        },
        {
          "name": "2b. Одобрить заявление с превышением лимита → 400",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/insurance/claims/2/approve?approvedAmount=9999999",
              "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "2", "approve"],
              "query": [{ "key": "approvedAmount", "value": "9999999" }]
            },
            "description": "Ожидаем 400 Bad Request — сумма превышает лимит покрытия."
          }
        },
        {
          "name": "3. Отклонить заявление (UNDER_REVIEW → REJECTED)",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/insurance/claims/2/reject?reason=Случай не является страховым по условиям договора",
              "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "2", "reject"],
              "query": [{ "key": "reason", "value": "Случай не является страховым по условиям договора" }]
            }
          }
        },
        {
          "name": "4. Произвести выплату (APPROVED → PAID)",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/insurance/claims/1/pay", "host": ["{{baseUrl}}"], "path": ["api", "insurance", "claims", "1", "pay"] }
          }
        },
        {
          "name": "5. Сгенерировать ежемесячные взносы для полиса",
          "request": {
            "method": "POST",
            "url": { "raw": "{{baseUrl}}/api/insurance/policies/1/generate-payments", "host": ["{{baseUrl}}"], "path": ["api", "insurance", "policies", "1", "generate-payments"] },
            "description": "Генерирует платёж на каждый месяц срока действия полиса на основе суммарного monthlyPremium покрытий."
          }
        },
        {
          "name": "6. Пометить просроченные взносы как OVERDUE",
