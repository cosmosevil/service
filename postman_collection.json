            "method": "DELETE",
            "url": { "raw": "{{baseUrl}}/api/coverages/3", "host": ["{{baseUrl}}"], "path": ["api", "coverages", "3"] }
          }
        },
        {
          "name": "Дублирующее название → 409",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/coverages", "host": ["{{baseUrl}}"], "path": ["api", "coverages"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"ОСАГО\",\n  \"description\": \"Дубликат\",\n  \"coverageLimit\": 100000.00,\n  \"monthlyPremium\": 500.00\n}" },
            "description": "Ожидаем 409 Conflict — покрытие с таким названием уже существует."
          }
        }
      ]
    },
