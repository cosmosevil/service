            "body": { "mode": "raw", "raw": "{\n  \"name\": \"ОСАГО\",\n  \"description\": \"Обязательное страхование — обновлено\",\n  \"coverageLimit\": 500000.00,\n  \"monthlyPremium\": 1350.00\n}" }
          }
        },
        {
          "name": "Удалить покрытие",
